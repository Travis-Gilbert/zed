+mod tests {
+    use super::*;
+
+    fn projected(node: &accesskit::Node) -> Vec<(&'static str, Option<String>)> {
+        state_attributes(&Mirrored::read(node))
+            .into_iter()
+            .map(|(attribute, value)| (attribute, value.map(str::to_owned)))
