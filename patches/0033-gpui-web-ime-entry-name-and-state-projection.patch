+    fn value_of(attributes: &[(&'static str, Option<String>)], name: &str) -> Option<String> {
+        attributes
+            .iter()
+            .find(|(attribute, _)| *attribute == name)
+            .and_then(|(_, value)| value.clone())
+    }
+
