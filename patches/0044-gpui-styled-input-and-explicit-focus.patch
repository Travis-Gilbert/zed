+    /// Build the normal test platform with an explicitly supplied real text
+    /// system. This qualifies shaping/caret geometry without claiming OS paint.
+    pub fn build_with_text_system(
+        dispatcher: TestDispatcher,
+        fn_name: Option<&'static str>,
+        text_system: Arc<dyn crate::PlatformTextSystem>,
