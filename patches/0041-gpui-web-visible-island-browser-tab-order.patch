From fdab04fcfbc3ae253669512a0bb265647fe2d0f6 Mon Sep 17 00:00:00 2001
From: Travis Gilbert <1travisgilbert@gmail.com>
Date: Thu, 15 Oct 2026 13:57:46 -0400
Subject: [PATCH] feat(gpui-web): let visible editing islands follow browser
 Tab order

---
 crates/gpui_web/src/editing_island.rs | 12 ++++++++++++
 crates/gpui_web/src/events.rs         | 11 +++++++++++
 crates/gpui_web/src/ime_mirror.rs     | 19 +++++++++++++++++++
 3 files changed, 42 insertions(+)

diff --git a/crates/gpui_web/src/editing_island.rs b/crates/gpui_web/src/editing_island.rs
index 85cf8c9..2e60f94 100644
--- a/crates/gpui_web/src/editing_island.rs
+++ b/crates/gpui_web/src/editing_island.rs
@@ -72,6 +72,18 @@ impl EditingIsland {
         inner.ime_mirror.island_is_live()
     }
 
+    /// Let plain Tab and Shift-Tab from this live textarea use browser focus
+    /// order. The hidden conduit retains GPUI traversal. An open composition
+    /// still owns those keys. Returns false after this island was replaced
+    /// or its window closed; a predecessor cannot configure its successor.
+    pub fn set_native_tab_navigation(&self, enabled: bool) -> bool {
+        self.window.upgrade().is_some_and(|inner| {
+            inner
+                .ime_mirror
+                .set_island_native_tab(&self.element, enabled)
+        })
+    }
+
     /// Schedule the existing coalesced mirror reconciliation after the
     /// canonical editor changes independently of browser input. Call on a
     /// revision or selection change, rather than on every rendered frame.
diff --git a/crates/gpui_web/src/events.rs b/crates/gpui_web/src/events.rs
index 307ebd3..44bea7d 100644
--- a/crates/gpui_web/src/events.rs
+++ b/crates/gpui_web/src/events.rs
@@ -828,6 +828,17 @@ impl WebWindowInner {
                 event.prevent_default();
                 return;
             }
+            if is_tab
+                && event
+                    .target()
+                    .and_then(|target| target.dyn_into::<web_sys::HtmlTextAreaElement>().ok())
+                    .is_some_and(|element| this.ime_mirror.island_uses_native_tab(&element))
+            {
+                // The visible page-owned editor participates in browser
+                // focus order. Let the same event bubble/default normally;
+                // entering the hidden conduit still uses GPUI's tab order.
+                return;
+            }
             let result = this.dispatch_input(PlatformInput::KeyDown(KeyDownEvent {
                 keystroke,
                 is_held,
diff --git a/crates/gpui_web/src/ime_mirror.rs b/crates/gpui_web/src/ime_mirror.rs
index e12b6c1..0fae3a4 100644
--- a/crates/gpui_web/src/ime_mirror.rs
+++ b/crates/gpui_web/src/ime_mirror.rs
@@ -411,6 +411,7 @@ pub(crate) struct ImeMirror {
     island: RefCell<Option<Rc<Conduit>>>,
     /// Whether the island, rather than a built conduit, is live.
     island_live: Cell<bool>,
+    island_native_tab: Cell<bool>,
     /// Set while the mirror itself edits the island through the browser's
     /// editing commands, which raise `beforeinput` and `input` synchronously.
     /// Those events are this module's echo, never an edit to import.
@@ -557,6 +558,7 @@ impl ImeMirror {
             selection_reversed: Cell::new(false),
             island: RefCell::new(None),
             island_live: Cell::new(false),
+            island_native_tab: Cell::new(false),
             writing: Cell::new(false),
             composition_checkpoint: RefCell::new(None),
             history_intents: RefCell::new(crate::history_intent::HistoryIntentGate::default()),
@@ -1102,9 +1104,25 @@ impl ImeMirror {
             element: ConduitElement::TextArea(element),
             page_owned: true,
         })));
+        self.island_native_tab.set(false);
         self.island_counts.set(EditingIslandCounts::default());
     }
 
+    pub(crate) fn set_island_native_tab(
+        &self,
+        element: &web_sys::HtmlTextAreaElement,
+        enabled: bool,
+    ) -> bool {
+        if !self.island.borrow().as_ref().is_some_and(|island| matches!(&island.element, ConduitElement::TextArea(adopted) if adopted == element)) { return false; }
+        self.island_native_tab.set(enabled);
+        true
+    }
+
+    pub(crate) fn island_uses_native_tab(&self, element: &web_sys::HtmlTextAreaElement) -> bool {
+        self.island_native_tab.get() && self.island_is_live()
+            && self.island.borrow().as_ref().is_some_and(|island| matches!(&island.element, ConduitElement::TextArea(adopted) if adopted == element))
+    }
+
     /// Forget the island, if `element` is it. A live island hands the input
     /// path back to the built conduits first.
     pub(crate) fn release_island(
@@ -1120,6 +1138,7 @@ impl ImeMirror {
         }
         self.set_island_live(window, false);
         self.island.replace(None);
+        self.island_native_tab.set(false);
         let html: &web_sys::Element = element.as_ref();
         html.remove_attribute(ISLAND_ATTRIBUTE).ok();
     }
-- 
2.53.0

